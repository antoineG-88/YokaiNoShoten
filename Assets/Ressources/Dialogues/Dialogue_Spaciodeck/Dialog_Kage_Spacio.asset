  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ffbc17fa17361574ab41e4b1fae041c2, type: 3}
  m_Name: Dialog_Kage_Spacio
  m_EditorClassIdentifier: 
  tsvDialogPath: Assets/Ressources/Dialogues/Dialogue_Spaciodeck/Dialogue_EN_Spaciodeck_Kage_1.tsv
  sentences:
  - sentence: I expected no less from you, Seiki.
    characterName: Unknown Spirit
    seikiReaction: 6
    speakingSpeed: 0.5
  - sentence: I go by the name Kage, and I have been trapped in this tower for quite
      a while now.
    characterName: Kage
    seikiReaction: 1
    speakingSpeed: 1
  - sentence: "You wouldn't be alive if it were not for your master Dor\u012Bm\u0101.
      He protected your energy from being absorbed, and the great Zenchi tree was
      able to resurect you."
    characterName: Kage
    seikiReaction: 0
    speakingSpeed: 1
  - sentence: But I'm scared you were the only one.__ The tree is completely corrupted
      by the Selvos now.
    characterName: Kage
    seikiReaction: 2
    speakingSpeed: 1
  - sentence: 'Your master got captured with many others, you must rescue them. '
    characterName: Kage
    seikiReaction: 3
    speakingSpeed: 1
  - sentence: 'I will guide you through this tower and try to help you on your ascent
      here. '
    characterName: Kage
    seikiReaction: 4
    speakingSpeed: 1
  - sentence: For now, try to reach the other survivors. _They are hidden higher
      in the tower.
    characterName: Kage
    seikiReaction: 0
    speakingSpeed: 1
